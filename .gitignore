# Dependencies
node_modules/
/node_modules
/web/node_modules/

# Next.js build output
.next/
/.next/
/web/.next/
out/
/out/
/web/out/
build/
/build/

# Environment files
.env
.env*.local
!.env.example
!/web/.env.example
!/crawler/.env.example

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
crawler/.temp/
.temp/

# Personal local user data & backups (keep .gitkeep)
data/user/*.json
data/user/*.tmp*
backups/

# Raw materials and media storage (PDFs, full MP3s, sliced audio, images)
# These large binary assets should be stored locally on the server/Samba share, not in Git
data/raw/
data/media/*
!data/media/.gitkeep
data/media/audio/*
!data/media/audio/.gitkeep
data/media/images/*
!data/media/images/.gitkeep

# Crawler intermediate artifacts (whisper raw, draft answer segments)
data/exams/**/intermediate/

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts
/web/next-env.d.ts
.cache/

# OS and logs
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
